{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "prompt.stash": "ctrl+s"
  },
  "theme": {
    "name": "system"
  },
  "session": {
    "sidebar": "hide"
  },
  "tabs": {
    "mode": "auto",
    "layout": "horizontal",
    "scope": "cwd",
    "indicators": "numbers"
  },
  "diffs": {
    "view": "auto"
  },
  "debug": {
    "devtools": false
  }
}
