{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "DISABLE_AUTO_COMPACT": "1",
    "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(//Users/sunan.maunakea/Developer/koppla-tech/**)",
      "Read(//Users/sunan.maunakea/Developer/projex/**)",
      "Read(//Users/sunan.maunakea/.dotfiles/**)",
      "Read(//Users/sunan.maunakea/.dotfiles/nvim/.config/nvim/**)",
      "Read(//Users/sunan.maunakea/.dotfiles/sskills/**)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/env.php*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/config/database.yml)"
    ]
  },
  "skillOverrides": {
    "review": "off",
    "security-review": "off",
    "simplify": "off",
    "verify": "off",
    "run": "off",
    "init": "off",
    "dataviz": "off",
    "keybindings-help": "off",
    "fewer-permission-prompts": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'case \"$PWD\" in */koppla-tech/notes*) exit 0 ;; */koppla-tech/*) echo \"TypeScript LSP is configured for this project. Before using Grep/Glob to find a symbol (function, class, type, interface, variable, method), call ToolSearch with query select:LSP to load LSP, then use goToDefinition/findReferences/hover. Grep is only for prose, comments, config strings, or file discovery.\" ;; esac'"
          }
        ]
      }
    ]
  },
  "disableWorkflows": true,
  "workflowKeywordTriggerEnabled": false,
  "allowAllClaudeAiMcps": false,
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-slides@frontend-slides": false,
    "typescript-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "frontend-slides": {
      "source": {
        "source": "git",
        "url": "https://github.com/zarazhangrui/frontend-slides.git"
      }
    }
  },
  "syntaxHighlightingDisabled": false,
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "voice": {
    "enabled": false
  },
  "channelsEnabled": false,
  "totalTokensReminder": "countdown",
  "disableAutoMode": "disable",
  "theme": "dark",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "mcpServers": {
    "excalidraw": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-excalidraw-server"
      ],
      "env": {
        "EXPRESS_SERVER_URL": "http://localhost:3000"
      }
    }
  }
}
